{
  "name": "cooling-cost-preview",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm dev:web",
    "dev:web": "vite --host 127.0.0.1",
    "dev:toss": "granite dev",
    "build": "pnpm build:web",
    "build:web": "vite build",
    "build:toss": "ait build",
    "preview:web": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.test.json",
    "lint": "eslint . --max-warnings 0",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "node tests/browser.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build:web",
    "format": "prettier --write src tests *.json *.ts *.js *.yaml"
  },
  "dependencies": {
    "@apps-in-toss/web-framework": "2.10.1",
    "@emotion/react": "11.14.0",
    "@toss/tds-colors": "0.1.0",
    "@toss/tds-mobile": "2.5.0",
    "@toss/tds-mobile-ait": "2.5.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "15.15.0",
    "prettier": "3.9.1",
    "typescript": "5.7.3",
    "typescript-eslint": "8.62.0",
    "vite": "6.4.3",
    "@types/node": "26.0.1",
    "playwright": "1.62.1"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.7.0"
  }
}
